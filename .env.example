# Copy to .env locally. On Render, set the same keys in the dashboard.

NODE_ENV=production

# Required in production (admin / scrape / match routes)
ADMIN_API_TOKEN=

# Neon connection string(s) — same DB as the rest of Pricely
DATABASE_URL=
# Prefer direct (non-pooler) host for long-running scrapers if you have it:
# DIRECT_DATABASE_URL=

# Comma-separated browser origins
CORS_ORIGINS=https://admin.pricely.rs,http://localhost:3000

# Cloudflare Images (image manager)
# CF_ACCOUNT_ID=
# CF_IMAGES_TOKEN=
# CF_IMAGES_HASH=

# Never enable in prod unless you really mean it
ALLOW_CLEAR_DB=false
