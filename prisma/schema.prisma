generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    Int                  @id @default(autoincrement())
  name                  String
  normalizedName        String?
  priceBeforeDiscount   Decimal? 
  price                 String
  store                 String
  category              String
  image                 String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  standardizedProductId Int?
  standardizedProduct   StandardizedProduct? @relation(fields: [standardizedProductId], references: [id])

  @@unique([normalizedName, store], name: "normalizedName_store")
}

model StandardizedProduct {
  id           Int       @id @default(autoincrement())
  name         String
  image        String?
  mainCategory String?
  midCategory  String?
  subCategory  String?
  brand        String?
  volume       String?
  attributes   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}
