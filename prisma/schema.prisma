generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    Int                  @id @default(autoincrement())
  name                  String
  normalizedName        String?
  priceBeforeDiscount   Decimal? 
  price                 String?
  store                 String
  category              String
  image                 String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  standardizedProductId Int?
  standardizedProduct   StandardizedProduct? @relation(fields: [standardizedProductId], references: [id])

  @@unique([normalizedName, store], name: "normalizedName_store")
}

model StandardizedProduct {
  id           Int       @id @default(autoincrement())
  name         String
  image        String?
  mainCategory String?
  midCategory  String?
  subCategory  String?
  brand        String?
  volume       String?
  attributes   Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([mainCategory, midCategory])
}

model Store {
  id        Int     @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  address   String
  city      String
}

model ReceiptScan {
  id                 Int      @id @default(autoincrement())
  scannedUrl         String
  scannedUrlHash     String
  userEmail          String?
  cartItemsSnapshot  Json?
  cartTotalSnapshot  Decimal?
  status             String   @default("pending")
  itemConfirmations  Json?
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime @default(now())
  purchaseGroupId    String?
  checkoutStoreLabel String?

  @@unique([scannedUrlHash])
  @@index([createdAt])
  @@index([userEmail])
  @@index([status])
  @@index([purchaseGroupId])
}

/// Email adrese prikupljene preko waiting liste (npr. newsletter / early access).
model WaitlistEmail {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdAt DateTime  @default(now())
  /// Kada je tim poslao odgovor ovoj adresi.
  repliedAt DateTime?
  /// Ko je odgovorio (npr. ime ili email člana tima).
  repliedBy String?

  @@index([createdAt])
  @@index([repliedAt])
}
