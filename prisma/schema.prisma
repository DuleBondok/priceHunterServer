

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  normalizedName String 
  price     String
  store     String
  category  String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, store], name: "name_store")
}