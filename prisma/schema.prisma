generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    Int                  @id @default(autoincrement())
  name                  String
  normalizedName        String?
  priceBeforeDiscount   Decimal? 
  price                 String?
  store                 String
  category              String
  image                 String
  lastSeenAt            DateTime             @default(now())
  isAvailable           Boolean              @default(true)
  consecutiveMissingDays Int                 @default(0)
  flaggedForReview      Boolean              @default(false)
  flaggedReason         String?
  flaggedAt             DateTime?
  requiresLoyaltyCard   Boolean              @default(false)
  offerEndsOn           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  standardizedProductId Int?
  standardizedProduct   StandardizedProduct? @relation(fields: [standardizedProductId], references: [id])

  @@unique([normalizedName, store], name: "normalizedName_store")
  @@index([lastSeenAt])
  @@index([isAvailable])
  @@index([flaggedForReview])
}

/// Scraped products not yet promoted to Product (pending review).
model NewProducts {
  id                  Int       @id @default(autoincrement())
  name                String
  normalizedName      String
  price               String?
  priceBeforeDiscount Decimal?
  store               String
  category            String
  image               String
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  processedAt         DateTime?

  @@unique([normalizedName, store])
  @@index([store])
  @@index([processedAt])
}

model StandardizedProduct {
  id           Int       @id @default(autoincrement())
  name         String
  image        String?
  mainCategory String?
  midCategory  String?
  subCategory  String?
  brand        String?
  volume             String?
  productDescription String?
  attributes         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([mainCategory, midCategory])
}

model Store {
  id           Int     @id @default(autoincrement())
  name         String
  latitude     Float
  longitude    Float
  address      String
  city         String
  /// Weekly opening hours as JSON. Keys: mon..sun.
  /// Day open: { "open": "08:00", "close": "21:00" }. Closed: null.
  /// Example: {"mon":{"open":"08:00","close":"21:00"},"tue":{"open":"08:00","close":"21:00"},"wed":{"open":"08:00","close":"21:00"},"thu":{"open":"08:00","close":"21:00"},"fri":{"open":"08:00","close":"21:00"},"sat":{"open":"08:00","close":"15:00"},"sun":null}
  openingHours Json?
}

model ReceiptScan {
  id                 Int       @id @default(autoincrement())
  scannedUrl         String
  scannedUrlHash     String
  /// Supabase auth.users.id when known (preferred identity).
  userId             String?
  userEmail          String?
  cartItemsSnapshot  Json?
  cartTotalSnapshot  Decimal?
  /// pending | confirmed | rejected
  status             String    @default("pending")
  /// Legacy JSON confirmations (kept for admin UI / history compat). Prefer ReceiptConfirmedItem rows.
  itemConfirmations  Json?
  confirmedBy        String?
  confirmedAt        DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  /// Verified spent/saved at confirm time (RSD). Null until confirmed.
  confirmedSpentRsd  Decimal?
  confirmedSavedRsd  Decimal?
  /// When points were ledgered for this receipt (idempotency audit).
  pointsGrantedAt    DateTime?
  createdAt          DateTime  @default(now())
  /// Isti ID za sve račune iz jedne multi-store kupovine (generiše klijent).
  purchaseGroupId    String?
  /// Ljudski naziv prodavnice pri skeniranju (npr. iz spiska za kupovinu).
  checkoutStoreLabel String?

  confirmedItems     ReceiptConfirmedItem[]
  pointsTransactions UserPointsTransaction[]

  @@unique([scannedUrlHash])
  @@index([createdAt])
  @@index([userEmail])
  @@index([userId])
  @@index([status])
  @@index([purchaseGroupId])
}

/// Admin-confirmed line items for a receipt (source of truth for verified purchases).
model ReceiptConfirmedItem {
  id                Int         @id @default(autoincrement())
  receiptId         Int
  receipt           ReceiptScan @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  /// Line id from cart snapshot / admin payload.
  lineId            String
  productId         String
  productName       String
  quantity          Int         @default(1)
  /// Optional unit price snapshot if known at confirm time.
  unitPriceRsd      Decimal?
  /// Catalog max−min × qty estimate at confirm (nullable if catalog unknown).
  estimatedSavedRsd Decimal?
  confirmedAt       DateTime    @default(now())

  @@unique([receiptId, lineId])
  @@index([receiptId])
  @@index([productId])
}

/// Running points balance per user (Neon source of truth). Keyed by email and/or auth userId.
model UserPointsAccount {
  id                    Int      @id @default(autoincrement())
  /// Lowercase email (legacy identity used by current app).
  userEmail             String?  @unique
  /// Supabase auth UUID when known.
  userId                String?  @unique
  /// Current spendable balance (after redemptions).
  balance               Int      @default(0)
  /// Lifetime points earned (never decreases on redeem).
  lifetimeEarned        Int      @default(0)
  /// Confirmed receipts that already granted points (denormalized).
  confirmedReceiptCount Int      @default(0)
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  transactions   UserPointsTransaction[]
  userChallenges UserChallenge[]
  userRewards    UserReward[]

  @@index([userEmail])
  @@index([userId])
}

enum PointsTransactionType {
  FIRST_CONFIRMED_RECEIPT
  CONFIRMED_RECEIPT
  CHALLENGE_COMPLETED
  REWARD_REDEEMED
  ADJUSTMENT
}

model UserPointsTransaction {
  id             Int                   @id @default(autoincrement())
  accountId      Int
  account        UserPointsAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount         Int
  type           PointsTransactionType
  receiptId      Int?
  receipt        ReceiptScan?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  challengeId    Int?
  challenge      Challenge?            @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  rewardId       Int?
  reward         Reward?               @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  /// Stable idempotency key e.g. "confirmed_receipt:123" / "reward_redeem:pavlaka:1"
  idempotencyKey String
  description    String?
  createdAt      DateTime              @default(now())

  @@unique([idempotencyKey])
  @@index([accountId, createdAt])
  @@index([receiptId])
}

model Challenge {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  title        String
  description  String?
  /// e.g. confirmed_receipt_count | points_balance | first_confirmed_receipt
  type         String
  target       Int      @default(1)
  pointsReward Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userChallenges     UserChallenge[]
  pointsTransactions UserPointsTransaction[]
}

model UserChallenge {
  id              Int               @id @default(autoincrement())
  accountId       Int
  account         UserPointsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  challengeId     Int
  challenge       Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress        Int               @default(0)
  completedAt     DateTime?
  rewardGrantedAt DateTime?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())

  @@unique([accountId, challengeId])
  @@index([accountId])
}

model Reward {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  title       String
  description String?
  /// Points cost to unlock/redeem (0 if granted by challenge).
  pointsCost  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRewards        UserReward[]
  pointsTransactions UserPointsTransaction[]
}

model UserReward {
  id          Int               @id @default(autoincrement())
  accountId   Int
  account     UserPointsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rewardId    Int
  reward      Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  unlockedAt  DateTime          @default(now())
  redeemedAt  DateTime?
  voucherCode String?
  expiresAt   DateTime?

  @@unique([accountId, rewardId])
  @@index([accountId])
}

/// Email adrese prikupljene preko waiting liste (npr. newsletter / early access).
model WaitlistEmail {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdAt DateTime  @default(now())
  /// Kada je tim poslao odgovor ovoj adresi.
  repliedAt DateTime?
  /// Ko je odgovorio (npr. ime ili email člana tima).
  repliedBy String?

  @@index([createdAt])
  @@index([repliedAt])
}

model UncoveredLocationPing {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  reason    String
  mode      String?
  createdAt DateTime @default(now())
}

model StoreFieldAudit {
  id                    Int       @id @default(autoincrement())
  standardizedProductId Int
  store                 String
  isAvailable           Boolean?
  priceCorrect          Boolean?
  correctedPrice        String?
  dbPriceSnapshot       String?
  notes                 String?
  checkedAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([standardizedProductId, store])
  @@index([store])
  @@index([checkedAt])
}

/// Privremeni staging feed iz Tekijanka partner API-ja (nije povezan sa Product).
model TekijankaArtikal {
  id            Int       @id @default(autoincrement())
  artikalSifra  Int       @unique
  nazivArtikla  String
  kategorija    String?
  podkategorija String?
  segment       String?
  jm            String?
  eanKod        String?
  redovnaCena   Decimal?  @db.Decimal(10, 2)
  akcijskaCena  Decimal?  @db.Decimal(10, 2)
  akcijaDatumOd DateTime?
  akcijaDatumDo DateTime?
  dostupnost    String?
  linkSlike     String?
  syncedAt      DateTime  @default(now()) @updatedAt
}

/// Admin-managed brand list for creating StandardizedProduct from unmatched Product rows.
model CatalogBrand {
  id        Int      @id @default(autoincrement())
  /// Canonical brand written to StandardizedProduct.brand (e.g. "Milk House").
  name      String
  /// Prefix matched at the start of Product.name (e.g. "MH").
  matchName String   @unique
  createdAt DateTime @default(now())
}

/// Permanently excluded listings. Scrape will not recreate Product/NewProducts for this key.
model BlockedProduct {
  id             Int      @id @default(autoincrement())
  normalizedName String
  store          String
  name           String
  category       String?
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([normalizedName, store], name: "blocked_normalizedName_store")
  @@index([store])
}
