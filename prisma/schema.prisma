generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    Int                  @id @default(autoincrement())
  name                  String
  normalizedName        String?
  priceBeforeDiscount   Decimal? 
  price                 String?
  store                 String
  category              String
  image                 String
  lastSeenAt            DateTime             @default(now())
  isAvailable           Boolean              @default(true)
  consecutiveMissingDays Int                 @default(0)
  flaggedForReview      Boolean              @default(false)
  flaggedReason         String?
  flaggedAt             DateTime?
  requiresLoyaltyCard   Boolean              @default(false)
  offerEndsOn           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  standardizedProductId Int?
  standardizedProduct   StandardizedProduct? @relation(fields: [standardizedProductId], references: [id])

  @@unique([normalizedName, store], name: "normalizedName_store")
  @@index([lastSeenAt])
  @@index([isAvailable])
  @@index([flaggedForReview])
}

/// Scraped products not yet promoted to Product (pending review).
model NewProducts {
  id                  Int       @id @default(autoincrement())
  name                String
  normalizedName      String
  price               String?
  priceBeforeDiscount Decimal?
  store               String
  category            String
  image               String
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  processedAt         DateTime?

  @@unique([normalizedName, store])
  @@index([store])
  @@index([processedAt])
}

model StandardizedProduct {
  id           Int       @id @default(autoincrement())
  name         String
  image        String?
  mainCategory String?
  midCategory  String?
  subCategory  String?
  brand        String?
  volume             String?
  productDescription String?
  attributes         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([mainCategory, midCategory])
}

model Store {
  id        Int     @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  address   String
  city      String
}

model ReceiptScan {
  id                 Int      @id @default(autoincrement())
  scannedUrl         String
  scannedUrlHash     String
  userEmail          String?
  cartItemsSnapshot  Json?
  cartTotalSnapshot  Decimal?
  status             String   @default("pending")
  itemConfirmations  Json?
  confirmedBy        String?
  confirmedAt        DateTime?
  createdAt          DateTime @default(now())
  purchaseGroupId    String?
  checkoutStoreLabel String?

  @@unique([scannedUrlHash])
  @@index([createdAt])
  @@index([userEmail])
  @@index([status])
  @@index([purchaseGroupId])
}

/// Email adrese prikupljene preko waiting liste (npr. newsletter / early access).
model WaitlistEmail {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdAt DateTime  @default(now())
  /// Kada je tim poslao odgovor ovoj adresi.
  repliedAt DateTime?
  /// Ko je odgovorio (npr. ime ili email člana tima).
  repliedBy String?

  @@index([createdAt])
  @@index([repliedAt])
}

model UncoveredLocationPing {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  reason    String
  mode      String?
  createdAt DateTime @default(now())
}

model StoreFieldAudit {
  id                    Int       @id @default(autoincrement())
  standardizedProductId Int
  store                 String
  isAvailable           Boolean?
  priceCorrect          Boolean?
  correctedPrice        String?
  dbPriceSnapshot       String?
  notes                 String?
  checkedAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([standardizedProductId, store])
  @@index([store])
  @@index([checkedAt])
}
